{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marian:m3b-draft:api-response.schema.json",
  "title": "Marian M3b CORE-DATE response (DRAFT)",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "rule_version",
        "data"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "rule_version": {
          "const": "marian-civil-v1.0"
        },
        "data": {
          "type": "object"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "rule_version",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "rule_version": {
          "const": "marian-civil-v1.0"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "SYNTAX_ERROR",
                "INVALID_DATE",
                "UNSUPPORTED_YEAR",
                "NEGATIVE_OFFSET",
                "UNINSTANTIATED_EPOCH",
                "UNRATIFIED_CLOCK_PROFILE",
                "UNCERTAIN_BOUNDARY",
                "UNSUPPORTED_PROFILE"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
