{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marian:m3b-draft:api-request.schema.json",
  "title": "Marian M3b CORE-DATE request (DRAFT, unratified)",
  "description": "Proposed machine interchange; valid JSON Schema does not imply year-dependent civil date validity.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "civil"
      ],
      "properties": {
        "action": {
          "const": "parse_civil"
        },
        "civil": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "ordinal"
      ],
      "properties": {
        "action": {
          "const": "parse_ordinal"
        },
        "ordinal": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "year",
        "ordinal_sol"
      ],
      "properties": {
        "action": {
          "const": "from_ordinal"
        },
        "year": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "ordinal_sol": {
          "type": "integer",
          "minimum": 1,
          "maximum": 669
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "offset_sols"
      ],
      "properties": {
        "action": {
          "const": "from_offset"
        },
        "offset_sols": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "date"
      ],
      "properties": {
        "action": {
          "const": "validate_civil_object"
        },
        "date": {
          "$ref": "#/$defs/civilDate"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "date"
      ],
      "properties": {
        "action": {
          "const": "validate_ordinal_object"
        },
        "date": {
          "$ref": "#/$defs/ordinalDate"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "year"
      ],
      "properties": {
        "action": {
          "const": "year_info"
        },
        "year": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "const": "absolute_time"
        }
      }
    }
  ],
  "$defs": {
    "civilDate": {
      "title": "Marian regular civil date (M3b conformance DRAFT)",
      "description": "Draft interchange shape; ALL year-specific validity and leap rules require algorithmic validation. Not a ratified public URL or officially published schema.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calendar",
        "rule_version",
        "year",
        "month",
        "week",
        "day"
      ],
      "properties": {
        "calendar": {
          "const": "marian"
        },
        "rule_version": {
          "const": "marian-civil-v1.0"
        },
        "year": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "week": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        }
      },
      "$comment": "Marian v1.0 ratified interchange shape. Applications MUST use calendar algorithm to reject e.g. MY2-03-08-07."
    },
    "ordinalDate": {
      "title": "Marian ordinal civil sol (M3b conformance DRAFT)",
      "description": "Year-local ordinal, NOT Mars Sol Date. Not an officially published schema URL. Algorithm must test 668/669 boundary by year.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calendar",
        "rule_version",
        "year",
        "ordinal_sol"
      ],
      "properties": {
        "calendar": {
          "const": "marian"
        },
        "rule_version": {
          "const": "marian-civil-v1.0"
        },
        "year": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "ordinal_sol": {
          "type": "integer",
          "minimum": 1,
          "maximum": 669
        }
      }
    }
  }
}
